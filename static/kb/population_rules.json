          "id": "DM-01",
          "type": "ingredient_group_warn",
          "groups": [
            "SUGAR_GROUP"
          ],
          "level": "高",
          "reason": "配料中含糖类物质（{items}），不利于血糖控制"
        },
        {
          "id": "DM-02",
          "type": "nutrition_min_warn",
          "nutrient": "糖",
          "value": 5,
          "unit": "g",
          "level": "中",
