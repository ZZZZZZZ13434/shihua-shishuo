{
  "version": "2026.2",
  "note": "人群适配库。weights 用于调整风险评分的营养素权重；rules 为触发式规则，命中后直接把该人群的风险等级提升到指定档位，并输出原因文本。最终等级取『加权评分等级』与『规则触发等级』的较高者。nutrition_min_warn 规则的 value 必须配合 unit 声明，引擎会先把标签数值换算到每 100g/100mL 并统一单位后再比较——修复前缺少 unit 导致『钠 0.35g/100g』无法触发 300mg 阈值。",
  "rule_types": {
    "ingredient_group_warn": "配料命中指定分组时触发",
    "nutrition_min_warn": "某营养素含量达到或超过阈值时触发（须声明 unit）",
    "additive_warn": "配料中含食品添加剂（可限定功能类别）时触发"
  },
  "populations": {
    "成人": {
      "desc": "普通成年人，按通用阈值判定",
      "weights": {},
      "rules": []
    },
