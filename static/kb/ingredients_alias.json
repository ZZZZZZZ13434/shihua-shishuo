{
  "version": "2026.2",
  "note": "配料别名归一库。alias 负责把包装上的各种写法归一到标准名；standards 定义标准名所属的语义分组。分组用于宣称核验（如'无糖'要求配料表不得出现 SUGAR_GROUP 成员）。 standards 必须覆盖 alias 的全部取值，否则归一后拿不到分组。",
  "group_definitions": {
    "SUCROSE_GROUP": {
      "name": "蔗糖类",
      "desc": "蔗糖及其常见商品形态，用于核验'0 蔗糖''无蔗糖'类宣称"
    },
    "SUGAR_GROUP": {
      "name": "糖类（单糖与双糖）",
      "desc": "按 GB 28050 对'糖'的定义（单糖与双糖之和）归集，用于核验'无糖''低糖'类宣称"
    },
    "SUGAR_SOURCE_GROUP": {
      "name": "含糖或高升糖潜力配料",
      "desc": "本身不属于单糖/双糖，但含糖量高或升糖速度快，用于给出提示而非直接判定违反"
    },
    "SUGAR_ALCOHOL_GROUP": {
      "name": "糖醇",
      "desc": "不属于糖，但常与'无糖'宣称同时出现，用于区分说明"
    },
    "SWEETENER_GROUP": {
      "name": "高倍甜味剂",
      "desc": "属于食品添加剂，用于'无添加'类核验与儿童人群提示"
    },
    "FIBER_GROUP": {
      "name": "膳食纤维类",
      "desc": "用于核验'高膳食纤维''富含膳食纤维'类宣称"
    },
    "CALCIUM_GROUP": {
      "name": "钙来源",
      "desc": "用于核验'高钙''富含钙'类宣称"
    },
    "PROTEIN_GROUP": {
      "name": "蛋白质来源",
      "desc": "用于核验'高蛋白'类宣称"
    }
  },
